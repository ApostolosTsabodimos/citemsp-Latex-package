\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{citemsp}[2025/04/21 v2.1 Per-key citation locators for biblatex]

% ── Dependencies ──────────────────────────────────────────────────────────────
\@ifpackageloaded{biblatex}{}{%
  \PackageError{citemsp}
    {The biblatex package must be loaded before citemsp}
    {Load biblatex with \string\usepackage[...]{biblatex} before
     \string\usepackage{citemsp}.}%
}
\@ifpackageloaded{natbib}{%
  \PackageWarning{citemsp}
    {natbib is loaded (possibly by your document class, e.g.\MessageBreak
     revtex4-2). biblatex and natbib are incompatible.\MessageBreak
     Consider using \string\documentclass{article} instead,\MessageBreak
     or pass the class option natbib=false if available}%
}{}

\RequirePackage{graphicx}   % \scalebox
\RequirePackage{etoolbox}   % \forcsvlist, \letcs (also loaded by biblatex)

% Load amssymb only when its symbols are not already provided (e.g. by stix,
% unicode-math, or newtxmath).  We test for \square which citemsp needs.
\AtBeginDocument{%
  \ifcsname square\endcsname\else
    \RequirePackage{amssymb}%
  \fi
}
% Provide fallback definitions in case neither amssymb nor another math font
% supplies the symbols we use in built-in prefixes.
\AtBeginDocument{%
  \providecommand{\square}{\Box}%
  \providecommand{\triangleq}{\ensuremath{\triangle\!=}}%
  \providecommand{\boxdot}{\ensuremath{\square\!\cdot}}%
  \providecommand{\boxplus}{\ensuremath{\square\!+}}%
}

% ── User-configurable sizing ──────────────────────────────────────────────────
\newcommand{\citemspscale}{0.35}
\newcommand{\citemspsize}[1]{\scalebox{\citemspscale}{#1}}
% Backward compatibility alias
\providecommand{\citesize}[1]{\citemspsize{#1}}

% ── Internal state ────────────────────────────────────────────────────────────
\newcommand{\@citesp@sec}{}
\newcommand{\@citesp@par}{}
\def\@citesp@itshape{it}%

% ── Hyperref-aware spacing ────────────────────────────────────────────────────
\def\@citesp@hrefkern{}
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \ifHy@colorlinks\else
      \def\@citesp@hrefkern{\kern1.5pt}%
    \fi
  }{}%
}

% ── Prefix registry ──────────────────────────────────────────────────────────
%  Maps a single-letter prefix to a rendered label.
%  Default (no recognized prefix): § for superscript slot, ¶ for subscript.
%
%  User command:  \citemspprefix{<letter>}{<label>}
%  Example:       \citemspprefix{w}{w.}   % register "w" for "widget"
%
\newcommand{\citemspprefix}[2]{%
  \expandafter\def\csname @citesp@pfx@#1\endcsname{#2}%
}

% ── Built-in prefixes ────────────────────────────────────────────────────────
\citemspprefix{b}{\ensuremath{\square}}%            box         □<num>
\citemspprefix{d}{\ensuremath{\triangleq}}%         definition  ≜<num>
\citemspprefix{e}{eq.}%                              equation    eq.<num>
\citemspprefix{f}{\ensuremath{\boxdot}}%            figure      ⊡<num>
\citemspprefix{n}{\ensuremath{\dagger}}%            footnote    †<num>
\citemspprefix{p}{pp.}%                              page        pp.<num>
\citemspprefix{t}{\ensuremath{\boxplus}}%           table       ⊞<num>

% ── Locator type dispatch ─────────────────────────────────────────────────────
%  \@citesp@renderloc{value}{default-symbol}
%  Checks first character against the prefix registry.
%
\def\@citesp@renderloc#1#2{%
  \expandafter\@citesp@dispatchloc#1\@citesp@end{#2}%
}
\def\@citesp@dispatchloc#1#2\@citesp@end#3{%
  \ifcsname @citesp@pfx@#1\endcsname
    \csname @citesp@pfx@#1\endcsname\kern1pt#2%
  \else
    #3\kern1pt#1#2%
  \fi
}

% ── Locator rendering helper ──────────────────────────────────────────────────
%  Prints the locator superscript/subscript pair.
%  Called only when at least one locator slot is non-empty.
\newcommand{\@citesp@renderlocators}{%
    % Adjust kerning when the surrounding text is italic
    \ifx\f@shape\@citesp@itshape
      \def\@citesp@supkern{\mkern2mu}%
      \def\@citesp@subkern{\mkern-1mu}%
    \else
      \def\@citesp@supkern{}%
      \def\@citesp@subkern{}%
    \fi
    % Render locators: dispatched by prefix
    \ifx\@citesp@sec\empty
      \@citesp@hrefkern
      $\mbox{}_{\@citesp@subkern\citemspsize{\@citesp@renderloc{\@citesp@par}{\P}}}$%
    \else
      \@citesp@hrefkern
      \ifx\@citesp@par\empty
        \raisebox{1.5pt}{$\mbox{}^{\@citesp@supkern\citemspsize{\@citesp@renderloc{\@citesp@sec}{\S}}}$}%
      \else
        \raisebox{1.5pt}{$\mbox{}^{\@citesp@supkern\citemspsize{\@citesp@renderloc{\@citesp@sec}{\S}}}_{\@citesp@subkern\citemspsize{\@citesp@renderloc{\@citesp@par}{\P}}}$}%
      \fi
    \fi
}

% ── Compression support detection ────────────────────────────────────────────
%  numeric-comp.cbx defines cite:comp and cite:dump for range compression.
%  We detect these at begin-document and set a flag.
\newif\if@citesp@comp
\AtBeginDocument{%
  \ifcsname abx@macro@cite:comp\endcsname
    \@citesp@comptrue
  \else
    \@citesp@compfalse
  \fi
}

% ── Core cite command ─────────────────────────────────────────────────────────
%  Integrates with biblatex's cite:comp/cite:dump when available (numeric-comp
%  style) so that plain entries get range compression (e.g. [12–19]).
%  Entries with locators flush any pending range and render individually.
%
%  Helper: render a locator entry, flushing any pending range first.
\newif\if@citesp@needsdelim
\newcommand{\@citesp@renderlocentry}{%
  \if@citesp@comp
    \usebibmacro{cite:dump}%
    \if@citesp@needsdelim{,\,}\fi
    % Reset comp state so next cite:comp emits a delimiter
    \setcounter{cbx@tempcnta}{0}%
    \setcounter{cbx@tempcntb}{-1}%
  \else
    \if@citesp@needsdelim{,\,}\fi
  \fi
  \bibhyperref{\printfield{labelnumber}}%
  \@citesp@renderlocators
  \global\@citesp@needsdelimtrue
}
%
%  \citelinksp is called with ALL keys at once by \citemsp.
%  The per-entry code retrieves stored locator data for the current key.
\DeclareCiteCommand{\citelinksp}
  {%
    \if@citesp@comp\usebibmacro{cite:init}\fi
    \global\@citesp@needsdelimfalse
  }
  {%
    \usebibmacro{citeindex}%
    % Retrieve locator data stored for this entry key
    \@citesp@loadloc{\thefield{entrykey}}%
    \ifx\@citesp@sec\empty
      \ifx\@citesp@par\empty
        % ── Plain entry: use compression if available ──
        \if@citesp@comp
          \usebibmacro{cite:comp}%
          \global\@citesp@needsdelimtrue
        \else
          \if@citesp@needsdelim{,\,}\fi
          \bibhyperref{\printfield{labelnumber}}%
          \global\@citesp@needsdelimtrue
        \fi
      \else
        % ── Subscript-only locator ──
        \@citesp@renderlocentry
      \fi
    \else
      % ── Superscript (possibly with subscript) locator ──
      \@citesp@renderlocentry
    \fi
  }
  {}
  {\if@citesp@comp\usebibmacro{cite:dump}\fi}

% ── Per-key locator storage ──────────────────────────────────────────────────
%  Before calling \citelinksp, \citemsp stores locator data for each key
%  in \@citesp@sec@<key> and \@citesp@par@<key> macros.
%  \@citesp@loadloc retrieves them.
\newcommand{\@citesp@storeloc}[3]{%  #1=key, #2=sec, #3=par
  \expandafter\def\csname @citesp@sec@#1\endcsname{#2}%
  \expandafter\def\csname @citesp@par@#1\endcsname{#3}%
}
\newcommand{\@citesp@loadloc}[1]{%  #1=entrykey
  \ifcsname @citesp@sec@#1\endcsname
    \letcs\@citesp@sec{@citesp@sec@#1}%
    \letcs\@citesp@par{@citesp@par@#1}%
  \else
    \def\@citesp@sec{}%
    \def\@citesp@par{}%
  \fi
}

% ── User command ──────────────────────────────────────────────────────────────
% \citemsp{key1/sec/par, key2/sec, key3}
%   Each entry: key  |  key/loc1  |  key/loc1/loc2
%   No prefix → §/¶;  letter prefix → see registry above
\def\@citesp@keys{}
\newcommand{\citemsp}[1]{%
  [%
  \def\@citesp@keys{}%
  \forcsvlist{\@citemsp@storeitem}{#1}%
  \expandafter\citelinksp\expandafter{\@citesp@keys}%
  ]%
}
\newcommand{\@citemsp@storeitem}[1]{%
  \@citemsp@parsestore#1///\@nil
}
\def\@citemsp@parsestore#1/#2/#3/#4\@nil{%
  \@citesp@storeloc{#1}{#2}{#3}%
  % Append key to the comma-separated key list
  \ifx\@citesp@keys\empty
    \def\@citesp@keys{#1}%
  \else
    \expandafter\def\expandafter\@citesp@keys\expandafter{\@citesp@keys,#1}%
  \fi
}

\endinput
