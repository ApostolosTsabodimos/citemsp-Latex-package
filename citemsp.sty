\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{citemsp}[2026/07/22 v2.3 Per-key citation locators (biblatex or natbib)]

% ── Backend detection ────────────────────────────────────────────────────────
%  citemsp can sit on top of either biblatex or natbib.  Whichever is loaded
%  first wins; if both are loaded (which itself would be an error), biblatex
%  is preferred.
\newif\if@citemsp@biblatex
\newif\if@citemsp@natbib
\@ifpackageloaded{biblatex}
  {\@citemsp@biblatextrue}
  {\@ifpackageloaded{natbib}
     {\@citemsp@natbibtrue}
     {\PackageError{citemsp}
        {Either biblatex or natbib must be loaded before citemsp}
        {Load \string\usepackage{biblatex} or \string\usepackage{natbib}
         (or use a class such as revtex4-2 that loads natbib automatically)
         before \string\usepackage{citemsp}.}}}

% ── Dependencies ──────────────────────────────────────────────────────────────
\RequirePackage{graphicx}   % \scalebox
\RequirePackage{etoolbox}   % \forcsvlist (biblatex pulls it; natbib does not)

% Fallback definitions for symbols used in built-in prefixes.
% If amssymb (or another math font such as stix, unicode-math, newtxmath)
% is loaded by the user, its definitions take precedence via \providecommand.
% Loading amssymb is recommended for best glyph quality but not required.
\AtBeginDocument{%
  \providecommand{\square}{\vrule height 6pt width 6pt depth -.2pt\relax}%
  \providecommand{\triangleq}{\ensuremath{\triangle\!=}}%
  \providecommand{\boxplus}{\ensuremath{\square\!+}}%
}

% ── User-configurable sizing ──────────────────────────────────────────────────
\newcommand{\citemspscale}{0.35}
\newcommand{\citemspraiseoffset}{1.5pt}
\newcommand{\citemspsize}[1]{\scalebox{\citemspscale}{#1}}

% ── Internal state ────────────────────────────────────────────────────────────
\newcommand{\@citemsp@sec}{}
\newcommand{\@citemsp@par}{}
\def\@citemsp@itshape{it}%
\def\@citemsp@slshape{sl}%

% ── Hyperref-aware spacing and link wrapper ──────────────────────────────────
%  \@citemsp@hrefkern : tiny kern after the bracketed number when hyperref is
%                     loaded without colorlinks (so the bracket doesn't kiss
%                     the locator subscript).
%  \@citemsp@linkwrap : on the natbib path, wraps the printed number in a
%                     hyperref jump to the bibliography entry.  On the biblatex
%                     path, biblatex's own \bibhyperref is used instead, so
%                     this stays as identity.
\def\@citemsp@hrefkern{}
\def\@citemsp@linkwrap#1#2{#2}
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \ifHy@colorlinks\else
      \def\@citemsp@hrefkern{\kern1.5pt}%
    \fi
    \if@citemsp@natbib
      \def\@citemsp@linkwrap#1#2{\hyperlink{cite.#1}{#2}}%
    \fi
  }{}%
}

% ── Prefix registry ──────────────────────────────────────────────────────────
%  Maps a single-letter prefix to a rendered label.
%  Default (no recognized prefix): § for superscript slot, ¶ for subscript.
%
%  User command:  \citemspprefix{<letter>}{<label>}
%  Example:       \citemspprefix{w}{w.}   % register "w" for "widget"
%
\newcommand{\citemspprefix}[2]{%
  \expandafter\def\csname @citemsp@pfx@#1\endcsname{#2}%
}

% ── Built-in prefixes ────────────────────────────────────────────────────────
\citemspprefix{A}{App.}%                             appendix    App.<num>
\citemspprefix{C}{Cor.}%                             corollary   Cor.<num>
\citemspprefix{d}{\ensuremath{\triangleq}}%          definition  ≜<num>
\citemspprefix{e}{eq.}%                              equation    eq.<num>
\citemspprefix{f}{fig.}%                             figure      fig.<num>
\citemspprefix{L}{Lem.}%                             lemma       Lem.<num>
\citemspprefix{n}{\ensuremath{\dagger}}%             footnote    †<num>
\citemspprefix{p}{pp.}%                              page        pp.<num>
\citemspprefix{t}{\ensuremath{\boxplus}}%            table       ⊞<num>
\citemspprefix{T}{Th.}%                              theorem     Th.<num>

% ── Locator type dispatch ─────────────────────────────────────────────────────
%  \@citemsp@renderloc{value}{default-symbol}
%  Checks first character against the prefix registry.
%
\def\@citemsp@renderloc#1#2{%
  \expandafter\@citemsp@dispatchloc#1\@citemsp@end{#2}%
}
\def\@citemsp@dispatchloc#1#2\@citemsp@end#3{%
  \ifcsname @citemsp@pfx@#1\endcsname
    \csname @citemsp@pfx@#1\endcsname\kern1pt#2%
  \else
    #3\kern1pt#1#2%
  \fi
}

% ── Locator-rendering body (backend-independent) ─────────────────────────────
%  Emits the super/subscript locator pair for the current \@citemsp@sec /
%  \@citemsp@par.  Called immediately after the citation number is printed.
%  Uses \textsection / \textparagraph instead of \S / \P to avoid clashing
%  with common physics preamble redefinitions of those commands.
\newcommand{\@citemsp@renderlocators}{%
  \ifx\f@shape\@citemsp@itshape
    \def\@citemsp@supkern{\mkern2mu}%
    \def\@citemsp@subkern{\mkern-1mu}%
  \else\ifx\f@shape\@citemsp@slshape
    \def\@citemsp@supkern{\mkern2mu}%
    \def\@citemsp@subkern{\mkern-1mu}%
  \else
    \def\@citemsp@supkern{}%
    \def\@citemsp@subkern{}%
  \fi\fi
  \ifx\@citemsp@sec\empty
    \ifx\@citemsp@par\empty\else
      \@citemsp@hrefkern
      ${}_{\@citemsp@subkern\citemspsize{\@citemsp@renderloc{\@citemsp@par}{\textparagraph}}}$%
    \fi
  \else
    \@citemsp@hrefkern
    \ifx\@citemsp@par\empty
      \raisebox{\citemspraiseoffset}{${}^{\@citemsp@supkern\citemspsize{\@citemsp@renderloc{\@citemsp@sec}{\textsection}}}$}%
    \else
      \raisebox{\citemspraiseoffset}{${}^{\@citemsp@supkern\citemspsize{\@citemsp@renderloc{\@citemsp@sec}{\textsection}}}_{\@citemsp@subkern\citemspsize{\@citemsp@renderloc{\@citemsp@par}{\textparagraph}}}$}%
    \fi
  \fi
}

% ── Backend-specific cite command ────────────────────────────────────────────
%  \citelinksp{<single-key>} prints the citation number (linked) followed by
%  the locator super/subscripts.  The list-and-bracket handling lives in
%  \citemsp below; here we only handle one key.
\if@citemsp@biblatex
  \DeclareCiteCommand{\citelinksp}
    {}
    {\bibhyperref{\printfield{labelnumber}}\@citemsp@renderlocators}
    {}
    {}
\else
  \newcommand{\citelinksp}[1]{%
    \@citemsp@linkwrap{#1}{\citenum{#1}}%
    \@citemsp@renderlocators
  }
\fi

% ── User command ──────────────────────────────────────────────────────────────
%   \citemsp{key1/sec/par, key2/sec, key3}
%   Each entry: key  |  key/loc1  |  key/loc1/loc2
%   No prefix → §/¶;  letter prefix → see registry above
%
%   Plain entries (no /) are batched and emitted via the backend's own \cite
%   so that numeric-comp / sort&compress range compression works naturally.
%   Locator entries are emitted individually.  The output interleaves
%   compressed plain runs and locator entries in their original order.

% Accumulator for a run of consecutive plain keys
\def\@citemsp@plainrun{}
% Whether we have started emitting anything (for comma insertion)
\newif\if@citemsp@started

% Flush a buffered plain-key run via \cite (backend handles compression)
\newcommand{\@citemsp@flushplain}{%
  \ifx\@citemsp@plainrun\empty\else
    \if@citemsp@started ,\,\fi
    \@citemsp@startedtrue
    \expandafter\@citemsp@citebare\expandafter{\@citemsp@plainrun}%
    \def\@citemsp@plainrun{}%
  \fi
}

\newcommand{\citemsp}[1]{%
  [%
  \def\@citemsp@plainrun{}%
  \@citemsp@startedfalse
  \forcsvlist{\@citemsp@item}{#1}%
  \@citemsp@flushplain % flush any trailing plain run
  ]%
}
\newcommand{\@citemsp@item}[1]{%
  \@citemsp@parse#1///\@nil
}
\def\@citemsp@parse#1/#2/#3/#4\@nil{%
  \def\@citemsp@sec{#2}%
  \def\@citemsp@par{#3}%
  \ifx\@citemsp@sec\empty
    \ifx\@citemsp@par\empty
      % Plain entry — accumulate into the plain-key buffer
      \ifx\@citemsp@plainrun\empty
        \def\@citemsp@plainrun{#1}%
      \else
        \edef\@citemsp@plainrun{\@citemsp@plainrun,\unexpanded{#1}}%
      \fi
    \else
      % Subscript-only entry — flush plain buffer, then emit
      \@citemsp@flushplain
      \if@citemsp@started ,\,\fi
      \@citemsp@startedtrue
      \citelinksp{#1}%
    \fi
  \else
    % Locator entry — flush plain buffer, then emit
    \@citemsp@flushplain
    \if@citemsp@started ,\,\fi
    \@citemsp@startedtrue
    \citelinksp{#1}%
  \fi
}

% ── Compression-aware bare-number cite ────────────────────────────────────────
%  \@citemsp@citebare{key1,key2,...} prints the backend's native \cite output
%  with brackets suppressed, so range compression (numeric-comp / sort&compress)
%  works exactly as it would for \cite.
\if@citemsp@biblatex
  \newcommand{\@citemsp@citebare}[1]{%
    \begingroup
      \renewcommand{\mkbibbrackets}[1]{##1}%
      \cite{#1}%
    \endgroup
  }
\else
  \newcommand{\@citemsp@citebare}[1]{%
    \begingroup
      \let\NAT@open\empty
      \let\NAT@close\empty
      \cite{#1}%
    \endgroup
  }
\fi

\endinput
